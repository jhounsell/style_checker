      <div class="govuk-accordion__section">
          <div class="govuk-accordion__section-header">
            <h2 class="govuk-accordion__section-heading govuk-heading-m">
              <span class="govuk-accordion__section-button" id="readability-results-button">
                Readability metrics
              </span>
            </h2>
            <div class="govuk-accordion__section-summary govuk-body" id="accordion-with-summary-sections-summary-2">
            Reading age: {{ results.readabilityMetrics.ageRange }} years old
            </div>
          </div>
          <div id="readability-results-content" class="govuk-accordion__section-content">
                <p class="govuk-body">
                Automated Readability Index score: {{ results.readabilityMetrics.automatedReadabilityIndex}} <br>
                This is equivalent to a reading age of <strong>{{ results.readabilityMetrics.ageRange }}</strong>.
                </p>
                <p class="govuk-body">
                    Your content:
                </p>
                <ul class="govuk-list govuk-list--bullet">
                <li>
                    is {{results.readabilityMetrics.totalWordCount}} words long
                </li>
                <li>
                    is {{results.readabilityMetrics.totalSentenceCount}} sentences long
                </li>
                <li>
                    has an average sentence length of {{results.readabilityMetrics.avgWordsPerSentence}} words
                </li>
                <li>
                    has an average word length of {{results.readabilityMetrics.avgCharsPerWord}} letters
                </li>
                </ul>
          </div>
      </div>